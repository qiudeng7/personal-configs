#!/usr/bin/env python3

"""Git pre-commit 入口：校验暂存区。"""

from pathlib import Path
import sys


HOOKS_DIR = Path(__file__).resolve().parent
if str(HOOKS_DIR) not in sys.path:
    sys.path.insert(0, str(HOOKS_DIR))

from commit_size_limitation.main import main as check_commit_size
from no_junk_files.main import main as check_junk_files


def main() -> int:
    for check in (check_junk_files, check_commit_size):
        result = check([])
        if result != 0:
            return result
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
